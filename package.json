{
  "name": "obsidian-mindmap-writing",
  "version": "0.0.4",
  "description": "Plugin Obsidian d'ecriture en branche (carte mentale)",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "esbuild tests/model.test.ts tests/layout.test.ts --bundle --platform=node --format=cjs --outdir=.test-build && node --test .test-build/model.test.js .test-build/layout.test.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  }
}
